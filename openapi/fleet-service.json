              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrbitShipResponse"
                }
              }
            }
          }
        },
        "description": "Move a ship from docked to orbit at its current waypoint.",
        "tags": [
          "ships"
        ],
        "security": [],
        "parameters": [
          {
            "in": "path",
            "name": "shipSymbol",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Authorization",
            "required": true,
            "schema": {
              "type": "string"
            }
