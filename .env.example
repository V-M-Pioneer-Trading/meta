# Copy to .env (docker compose loads this automatically) and fill in real
# values — neither has a sensible default at the compose level.

# The ship automation-service's autopilot drives. Must be a real ship symbol
# from your SpaceTraders agent's fleet.
MINING_SHIP_SYMBOL=

# ai-service's OpenAI API key, used for the anomaly-triggered supervisor loop.
OPENAI_API_KEY=

# --- Authentication ---------------------------------------------------------
# Both are optional locally. Compose falls back to the committed development
# keypair in dev-keys/, so the backends start and verify real signatures with
# no Clerk account — see dev-keys/README.md. There is no "auth off" mode.

# A Clerk development instance's public key (PEM). Set this only when you want
# to drive the real UI, which needs Clerk's SDK to mint sessions; it overrides
# the dev keypair. Mint tokens for the dev keypair instead with:
#   node scripts/mint-dev-token.mjs
CLERK_JWT_KEY=

# Matching publishable key for command-interface's Vite build. Publishable keys
# are public by design, so this is configuration rather than a secret.
VITE_CLERK_PUBLISHABLE_KEY=

# Shared secret ai-service presents on POST /api/automation/v1/events. Defaults
# to a local value in compose; must be a real secret in production.
AI_SERVICE_SECRET=
